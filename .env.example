# --- Core ---
# Path of the SQLite file (created automatically).
DATABASE_PATH=data/sharefly.db
# Long random string used to sign the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string
# Shows the "Demo: switch person" control. Leave false in production.
DEMO_MODE=true

# --- AI (all optional; the app works with AI_PROVIDER=none) ---
# anthropic | gemini | mock | none
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Storage ---
# local (default). Files go to data/uploads.
STORAGE_PROVIDER=local

# --- Reference spaces: real apartment floor plans from the CoStar kit (kept local, never committed) ---
# none (default) | costar. costar needs the file written by `npm run import:costar`; if it is missing the app behaves as none.
REFERENCE_SPACES_PROVIDER=none
REFERENCE_SPACES_PATH=data/reference-spaces.json
# Where the importer finds the kit (a folder containing data/apartment-listing.jsonl).
COSTAR_KIT_DIR=costar-hackathon-kit
