DATABASE_PATH=data/sharefly.db
# Long random string used to sign the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string
# Shows the "Demo: switch person" control. Leave false in production.
DEMO_MODE=true

# --- AI (all optional; the app works with AI_PROVIDER=none) ---
# gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=example
# --- Storage ---
STORAGE_PROVIDER=uploadthing

# --- Optional reference spaces (CoStar / Matterport). Not used unless confirmed. ---
REFERENCE_SPACES_PROVIDER=costar

MATTERPORT_API_KEY=example
MATTERPORT_API_SECRET=example

MATTERPORT_SDK_KEY=example
MATTERPORT_SDK_DOMAINS=localhost

VEXCEL_API_KEY=example

MONGO_URI=mongodb+srv://username:password@cluster0.j4cmw.mongodb.net/

UPLOADTHING_TOKEN=example

NEXT_PUBLIC_MATTERPORT_SDK_KEY=example
