# Copy this file to backend/.env and fill in real values there.
# backend/.env is ignored by git. Never commit real credentials or paste them into chat.

# --- Storage -----------------------------------------------------------------
# auto    = use MongoDB Atlas when MONGODB_URI is set and reachable, else local SQLite
# sqlite  = always use local SQLite
# mongodb = require MongoDB (the server refuses to start if it cannot connect)
STORAGE_BACKEND=auto

# Atlas connection string: Atlas > Database > Connect > Drivers > Python.
# Looks like: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=patternwitness
# MONGODB_TIMEOUT_MS=5000

# Optional: run the storage tests against a real cluster (uses a throwaway database).
# PATTERNWITNESS_TEST_MONGODB_URI=

# --- Gemini (Phase 2, not used yet) --------------------------------------------
# GEMINI_API_KEY=
